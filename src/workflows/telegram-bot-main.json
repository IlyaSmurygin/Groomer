        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chatId\": {{ $json.chatId }},\n  \"text\": \"❓ Неизвестная команда: {{ $json.command }}\\n\\nИспользуйте /help для списка доступных команд.\"\n}",
        "options": {
