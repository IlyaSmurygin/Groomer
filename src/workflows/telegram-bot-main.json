        },
        "options": {}
      },
      "id": "b2c3d4e5-f6g7-h8i9-j0k1-l2m3n4o5p6q7",
      "name": "Is New User?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO clients (telegram_id, username, first_name, last_name)\nVALUES (\n  {{ $('Webhook Trigger').first().json.body.message.from.id }},\n  '{{ $('Webhook Trigger').first().json.body.message.from.username || '' }}',\n  '{{ $('Webhook Trigger').first().json.body.message.from.first_name || '' }}',\n  '{{ $('Webhook Trigger').first().json.body.message.from.last_name || '' }}'\n)\nON CONFLICT (telegram_id) DO NOTHING\nRETURNING *",
        "options": {}
      },
      "id": "c3d4e5f6-g7h8-i9j0-k1l2-m3n4o5p6q7r8",
      "name": "Create User",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Извлекаем данные из webhook Telegram\nconst webhookData = $('Webhook Trigger').first().json;\nconst message = webhookData.body.message;\n\nreturn {\n  command: message.text || '',\n  chatId: message.chat.id,\n  userId: message.from.id,\n  username: message.from.username || '',\n  firstName: message.from.first_name || '',\n  lastName: message.from.last_name || ''\n};"
      },
      "id": "d4e5f6g7-h8i9-j0k1-l2m3-n4o5p6q7r8s9",
      "name": "Extract Message Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "cond1",
                    "leftValue": "={{ $json.command }}",
                    "rightValue": "/start",
                    "operator": {
                      "type": "string",
                      "operation": "startsWith"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "start"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "cond2",
                    "leftValue": "={{ $json.command }}",
                    "rightValue": "/services",
                    "operator": {
                      "type": "string",
                      "operation": "startsWith"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "services"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "cond3",
                    "leftValue": "={{ $json.command }}",
                    "rightValue": "/help",
                    "operator": {
                      "type": "string",
                      "operation": "startsWith"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "help"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "e5f6g7h8-i9j0-k1l2-m3n4-o5p6q7r8s9t0",
      "name": "Route Command",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BOT_SERVICE_URL || 'http://bot-service:3000' }}/send-message",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chatId\": {{ $json.chatId }},\n  \"text\": \"🐾 Добро пожаловать в {{ $env.SALON_NAME || 'Груминг Салон' }}!\\n\\nЯ помогу вам записаться на процедуры для вашего питомца.\\n\\n📋 Доступные команды:\\n/services - Наши услуги\\n/help - Помощь\\n\\nДля начала работы посмотрите наши услуги командой /services\",\n  \"parseMode\": \"Markdown\"\n}",
        "options": {
          "timeout": 5000,
          "retry": {
            "enabled": true,
            "maxRetries": 3,
            "retryInterval": 1000
          }
        }
      },
      "id": "f6g7h8i9-j0k1-l2m3-n4o5-p6q7r8s9t0u1",
      "name": "Send Welcome Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        180
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT id, name, description, duration, price, pet_types\nFROM services \nWHERE is_active = true \nORDER BY id",
        "options": {}
      },
      "id": "g7h8i9j0-k1l2-m3n4-o5p6-q7r8s9t0u1v2",
      "name": "Get Services List",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        1560,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Форматируем список услуг для отправки\nconst services = $input.all();\nconst chatId = $('Extract Message Data').first().json.chatId;\n\nif (services.length === 0) {\n  return {\n    chatId: chatId,\n    text: '❌ Услуги временно недоступны. Попробуйте позже.'\n  };\n}\n\nlet message = '📋 Наши услуги:\\n\\n';\n\nservices.forEach((item, index) => {\n  const service = item.json;\n  message += `${index + 1}. *${service.name}*\\n`;\n  message += `   ${service.description}\\n`;\n  message += `   💰 Стоимость: ${service.price} ₽\\n`;\n  message += `   ⏱️ Длительность: ${service.duration} мин\\n\\n`;\n});\n\nmessage += '\\n📞 Для записи свяжитесь с нами:\\n';\nmessage += `Телефон: ${process.env.SALON_PHONE || '+7 (999) 123-45-67'}\\n`;\nmessage += `Адрес: ${process.env.SALON_ADDRESS || 'см. описание бота'}`;\n\nreturn {\n  chatId: chatId,\n  text: message,\n  parseMode: 'Markdown'\n};"
      },
      "id": "h8i9j0k1-l2m3-n4o5-p6q7-r8s9t0u1v2w3",
      "name": "Format Services Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BOT_SERVICE_URL || 'http://bot-service:3000' }}/send-message",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chatId\": {{ $json.chatId }},\n  \"text\": {{ JSON.stringify($json.text) }},\n  \"parseMode\": \"{{ $json.parseMode || 'Markdown' }}\"\n}",
        "options": {
          "timeout": 5000,
          "retry": {
            "enabled": true,
            "maxRetries": 3,
            "retryInterval": 1000
