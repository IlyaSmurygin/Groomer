        "method": "POST",
        "url": "={{ $env.BOT_SERVICE_URL || 'http://bot-service:3000' }}/send-message",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chatId\": {{ $json.chatId }},\n  \"text\": \"ℹ️ *Помощь по использованию бота*\\n\\n📋 Доступные команды:\\n/start - Начало работы\\n/services - Список услуг\\n/help - Эта справка\\n\\n📞 *Контакты:*\\nТелефон: {{ $env.SALON_PHONE || '+7 (999) 123-45-67' }}\\nАдрес: {{ $env.SALON_ADDRESS || 'Москва' }}\\n\\n⏰ *Рабочие часы:*\\n{{ $env.WORKING_HOURS_START || '09:00' }} - {{ $env.WORKING_HOURS_END || '19:00' }}\\n\\n💡 *Как записаться:*\\nДля записи на процедуры используйте команды бота или свяжитесь с нами по телефону.\",\n  \"parseMode\": \"Markdown\"\n}",
        "options": {
          "timeout": 5000,
          "retry": {
            "enabled": true,
            "maxRetries": 3,
            "retryInterval": 1000
          }
        }
      },
      "id": "j0k1l2m3-n4o5-p6q7-r8s9-t0u1v2w3x4y5",
      "name": "Send Help Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
