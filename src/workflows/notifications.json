{
  "name": "Notifications - Appointment Reminders (Microservice)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger-id-001",
      "name": "Schedule Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT \n  a.id as appointment_id,\n  a.appointment_date,\n  a.appointment_time,\n  a.reminder_sent,\n  a.client_id,\n  c.telegram_id,\n  c.first_name,\n  c.last_name,\n  p.name as pet_name,\n  p.breed as pet_breed,\n  s.name as service_name,\n  s.price,\n  s.duration\nFROM appointments a\nJOIN clients c ON a.client_id = c.id\nJOIN pets p ON a.pet_id = p.id\nJOIN services s ON a.service_id = s.id\nWHERE \n  a.status = 'scheduled'\n  AND a.reminder_sent = false\n  AND a.appointment_date = (CURRENT_DATE + INTERVAL '1 day')::date",
        "options": {}
      },
      "id": "find-appointments-id-002",
      "name": "Find Tomorrow Appointments",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-data",
              "leftValue": "={{ $json.length }}",
              "rightValue": "0",
              "operator": {
                "type": "number",
                "operation": "largerThan"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-appointments-id-003",
      "name": "Has Appointments?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Форматируем сообщение-напоминание\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  \n  // Форматируем дату\n  const date = new Date(data.appointment_date);\n  const dateStr = date.toLocaleDateString('ru-RU', {\n    day: '2-digit',\n    month: '2-digit',\n    year: 'numeric'\n  });\n  \n  // Формируем сообщение\n  const clientName = data.last_name ? \n    `${data.first_name} ${data.last_name}` : \n    data.first_name;\n  \n  const message = `🔔 Напоминание о записи!\n\n👤 ${clientName}, напоминаем о визите завтра:\n\n📅 Дата: ${dateStr}\n🕐 Время: ${data.appointment_time}\n🐾 Питомец: ${data.pet_name} (${data.pet_breed})\n✂️ Услуга: ${data.service_name}\n⏱️ Длительность: ${data.duration} мин\n💰 Стоимость: ${data.price} ₽\n\n📍 Адрес: ${process.env.SALON_ADDRESS || 'уточняйте при звонке'}\n📞 Телефон: ${process.env.SALON_PHONE || '+7 (999) 123-45-67'}\n\nБудем рады вас видеть! 🐕🐈`;\n  \n  results.push({\n    chatId: data.telegram_id,\n    message: message,\n    appointmentId: data.appointment_id,\n    clientId: data.client_id,\n    type: 'reminder'\n  });\n}\n\nreturn results;"
      },
      "id": "prepare-messages-id-004",
      "name": "Prepare Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BOT_SERVICE_URL || 'http://bot-service:3000' }}/send-notification",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chatId\": {{ $json.chatId }},\n  \"text\": {{ JSON.stringify($json.message) }},\n  \"type\": \"{{ $json.type }}\"\n}",
        "options": {
          "timeout": 10000,
          "retry": {
            "enabled": true,
            "maxRetries": 5,
            "retryInterval": 2000
          }
        }
      },
      "id": "send-reminder-id-005",
      "name": "Send Reminder via Bot Service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE appointments \nSET reminder_sent = true,\n    updated_at = CURRENT_TIMESTAMP\nWHERE id = {{ $json.appointmentId }}",
        "options": {}
      },
      "id": "mark-sent-id-006",
      "name": "Mark Reminder Sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list",
          "cachedResultName": "public"
        },
        "table": {
          "__rl": true,
          "value": "notifications",
          "mode": "list",
          "cachedResultName": "notifications"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "appointment_id": "={{ $('Prepare Messages').item.json.appointmentId }}",
            "client_id": "={{ $('Prepare Messages').item.json.clientId }}",
            "type": "reminder",
            "message": "={{ $('Prepare Messages').item.json.message }}",
            "status": "sent",
            "sent_at": "={{ $now.toISO() }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "log-notification-id-007",
      "name": "Log Notification",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        1340,
        450
      ]
    }
  ],
