# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ADMIN_ID=your_telegram_user_id

# Database Configuration
DATABASE_URL=postgresql://grooming_user:grooming_pass@postgres:5432/grooming_salon
DB_HOST=postgres
DB_PORT=5432
DB_NAME=grooming_salon
DB_USER=grooming_user
DB_PASSWORD=grooming_pass

# N8N Configuration
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123
N8N_ENCRYPTION_KEY=your_random_encryption_key_here
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Application Configuration
NODE_ENV=development
PORT=3000
TIMEZONE=Europe/Moscow

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Salon Configuration
SALON_NAME=Груминг Салон
SALON_ADDRESS=Москва, ул. Примерная, д. 1
SALON_PHONE=+7 (999) 123-45-67
WORKING_HOURS_START=09:00
WORKING_HOURS_END=19:00

# Notification Configuration
REMINDER_HOURS_BEFORE=24
MAX_ADVANCE_BOOKING_DAYS=30

# Security
SESSION_SECRET=your_random_session_secret_here
